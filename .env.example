# =========================================================
# Enterprise Creative Suite - Environment Configuration
# =========================================================

# [REQUIRED in Dev / Staging] Google Gemini Free Tier or Pay-As-You-Go API Key
# Get a key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# [RECOMMENDED for Production] Dedicated Pay-As-You-Go Google Gemini API Key
# Setting this automatically switches presentation & AI engines to high-throughput Pay-As-You-Go mode.
GEMINI_PAYG_API_KEY=

# [OPTIONAL] Explicit Billing Tier: 'free' | 'pay_as_you_go' | 'enterprise'
# Automatically defaults to 'pay_as_you_go' in production or when GEMINI_PAYG_API_KEY is provided.
GEMINI_BILLING_TIER=pay_as_you_go

# [OPTIONAL] Comma-separated pool of Gemini API keys for automatic round-robin and rate-limit rotation
# GEMINI_API_KEYS=AIzaSy1...,AIzaSy2...,AIzaSy3...

# [OPTIONAL for Enterprise] Google Cloud Vertex AI Integration (Enterprise Pay-As-You-Go with SLAs)
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# [OPTIONAL] Server Port (Defaults to 3000)
PORT=3000

# [OPTIONAL] Fal.ai API Key for premium visual models (e.g. openai/gpt-image-2)
FAL_API_KEY=

# [OPTIONAL] Razorpay credentials for payment checkout & subscription billing
VITE_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
