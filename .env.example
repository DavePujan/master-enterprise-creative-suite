# =============================================================================
# WRITOPEDIA PRODUCTION CONFIGURATION TEMPLATE (.env.example)
# Target Application Domain: https://ai.writopedia.com
# Corporate Domain: https://writopedia.com (Separate - Do not route/deploy here)
# =============================================================================
# NEVER COMMIT REAL PRODUCTION SECRETS TO VERSION CONTROL.
# =============================================================================

# =============================================================================
# 1. VERCEL CLIENT ENVIRONMENT (Bundled into Frontend SPA at Build Time)
# Required in: Vercel Project Settings -> Environment Variables (Production & Preview)
# =============================================================================
# Public HTTPS URL of the Supabase project
VITE_SUPABASE_URL=https://your-project.supabase.co

# Public anon key (or publishable key) for browser Supabase client
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Razorpay public Key ID for client checkout modal (rzp_live_... or rzp_test_...)
VITE_RAZORPAY_KEY_ID=rzp_live_...

# Optional API base URL override (leave blank to default to same-origin /api)
# VITE_API_URL=https://ai.writopedia.com/api

# =============================================================================
# 2. VERCEL SERVER ENVIRONMENT (Serverless Functions - apps/api/src via api/index.ts)
# Required in: Vercel Project Settings -> Environment Variables (Server-Only, No VITE_ prefix)
# =============================================================================
# Supabase project URL and privileged service role key (bypasses RLS for server administration)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Google Gemini API Key (Multimodal brand intelligence, strategy analysis)
GEMINI_API_KEY=AIzaSy...

# fal.ai API key for AI generation (Kling/Seedance models)
FAL_KEY=...

# Razorpay live/test credentials for server-side order creation & HMAC verification
RAZORPAY_KEY_ID=rzp_live_...
RAZORPAY_KEY_SECRET=...
RAZORPAY_WEBHOOK_SECRET=...

# Resend API key & verified sender email on writopedia.com domain
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL="Writopedia <notifications@writopedia.com>"
BILLING_ALERT_EMAIL="support@writopedia.com"

# Secret bearer token guarding /api/admin/* impersonation and system maintenance
ADMIN_ACCESS_TOKEN=...

# =============================================================================
# 3. RAILWAY PERSISTENT WORKER ENVIRONMENT (apps/worker/src/index.ts)
# Required in: Railway Service Settings -> Variables
# =============================================================================
# Worker reads jobs from Supabase ai_generation_jobs & presentation_exports
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
# GEMINI_API_KEY=AIzaSy...
# FAL_KEY=...
# PORT=8080

# =============================================================================
# 4. LOCAL DEVELOPMENT & TESTING ONLY
# =============================================================================
NODE_ENV=development
PORT=3000
ENABLE_PAYMENT_SIMULATION=false
# NGROK_AUTHTOKEN=...
