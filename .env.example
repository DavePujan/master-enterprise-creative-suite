# =========================================================
# Enterprise Creative Suite - Environment Configuration
# =========================================================

# [REQUIRED] Google Gemini / AI Studio API Key
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# [OPTIONAL] Server Port (Defaults to 3000)
PORT=3000

# [OPTIONAL] Fal.ai API Key for premium visual models (e.g. openai/gpt-image-2)
FAL_API_KEY=

# [OPTIONAL] Razorpay credentials for payment checkout & subscription billing
VITE_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
