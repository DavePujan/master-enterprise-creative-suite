{
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./*"
      ],
      "@web/*": [
        "./apps/web/src/*"
      ],
      "@api/*": [
        "./apps/api/src/*"
      ],
      "@contracts/*": [
        "./packages/contracts/*"
      ],
      "@shared-types/*": [
        "./packages/types/*"
      ],
      "@errors/*": [
        "./packages/errors/*"
      ],
      "@utils/*": [
        "./packages/utils/*"
      ],
      "@presentation-engine/*": [
        "./packages/presentation-engine/*"
      ]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true
  }
}
