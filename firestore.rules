rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Primitive Definition
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "hardeep.pathak@gmail.com" || 
        request.auth.token.email == "avdhesh.babaria@gmail.com"
      );
    }

    // Phase 2: Validation Blueprints (The "Anti-Update-Gap")
    function isValidUser(data) {
      return data.keys().hasAll(['balance', 'createdAt', 'updatedAt']) 
        && data.keys().size() <= 3
        && data.balance is number 
        && data.createdAt is number
        && data.updatedAt is number;
    }

    function isValidBrandGuideline(data) {
       return data.keys().hasAll(['name', 'mission', 'tone', 'colors', 'updatedAt'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.mission is string && data.mission.size() <= 1000
        && data.tone is list && data.tone.size() <= 20 && (data.tone.size() == 0 || data.tone[0] is string)
        && data.colors is list && data.colors.size() <= 20 && (data.colors.size() == 0 || data.colors[0] is string)
        && data.updatedAt is number;
    }

    function isValidAsset(data) {
        return data.keys().hasAll(['type', 'content', 'prompt', 'timestamp'])
         && data.type is string && data.type.size() <= 50
         && data.content is string && data.content.size() <= 1000000 // 1MB limit check
         && data.prompt is string && data.prompt.size() <= 10000
         && data.timestamp is number;
    }

    function isValidHistoryLog(data) {
        return data.keys().hasAll(['gemId', 'prompt', 'title', 'result', 'timestamp'])
         && data.gemId is string && data.gemId.size() <= 100
         && data.prompt is string && data.prompt.size() <= 10000
         && data.title is string && data.title.size() <= 200
         && data.result is map
         && data.timestamp is number;
    }

    function isValidHumanTouchRequest(data) {
        return data.keys().hasAll(['assetType', 'assetUrl', 'originalPrompt', 'modelsUsed', 'userComment', 'emailReceipt', 'status', 'timestamp'])
         && data.assetType is string && data.assetType.size() <= 100
         && data.assetUrl is string && data.assetUrl.size() <= 1000000
         && data.originalPrompt is string && data.originalPrompt.size() <= 20000
         && data.modelsUsed is string && data.modelsUsed.size() <= 1000
         && data.userComment is string && data.userComment.size() <= 10000
         && data.emailReceipt is string && data.emailReceipt.size() <= 200
         && data.status is string && data.status.size() <= 100
         && data.timestamp is number;
    }

    function isValidGlobalHumanTouchRequest(data) {
        return data.keys().hasAll(['assetType', 'assetUrl', 'originalPrompt', 'modelsUsed', 'userComment', 'emailReceipt', 'status', 'timestamp', 'userId', 'userEmail'])
         && data.assetType is string && data.assetType.size() <= 100
         && data.assetUrl is string && data.assetUrl.size() <= 1000000
         && data.originalPrompt is string && data.originalPrompt.size() <= 20000
         && data.modelsUsed is string && data.modelsUsed.size() <= 1000
         && data.userComment is string && data.userComment.size() <= 10000
         && data.emailReceipt is string && data.emailReceipt.size() <= 200
         && data.status is string && data.status.size() <= 100
         && data.timestamp is number
         && data.userId is string && data.userId.size() <= 128
         && data.userEmail is string && data.userEmail.size() <= 200;
    }

    function isValidAdminSettings(data) {
        return data.keys().hasAll(['enableAiRewrite', 'enableGuidelines', 'enablePhotoStyling', 'enableCinematicStoryboard', 'allowTextOnAssets'])
         && data.keys().size() == 5
         && data.enableAiRewrite is bool
         && data.enableGuidelines is bool
         && data.enablePhotoStyling is bool
         && data.enableCinematicStoryboard is bool
         && data.allowTextOnAssets is bool;
    }

    function isValidSalesSubmission(data) {
        return data.keys().hasAll(['companyName', 'contactName', 'email', 'teamSize', 'message', 'status', 'timestamp'])
         && data.keys().size() == 7
         && data.companyName is string && data.companyName.size() <= 200
         && data.contactName is string && data.contactName.size() <= 200
         && data.email is string && data.email.size() <= 200
         && data.teamSize is string && data.teamSize.size() <= 100
         && data.message is string && data.message.size() <= 5000
         && data.status is string && data.status.size() <= 50
         && data.timestamp is number;
    }

    // The Fortresses
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidId(userId) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['balance', 'updatedAt'])
        && incoming().balance is number
        && incoming().updatedAt is number
      );
      
      match /brand_guidelines/{guidelineId} {
        allow list, get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(guidelineId) && isValidBrandGuideline(incoming());
        allow update: if isOwner(userId) && isValidId(userId) && isValidId(guidelineId) && isValidBrandGuideline(incoming());
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(guidelineId);
      }

      match /assets/{assetId} {
        allow list, get: if isOwner(userId) || isAdmin();
        allow create: if (isOwner(userId) || isAdmin()) && isValidId(userId) && isValidId(assetId) && isValidAsset(incoming());
        allow update: if (isOwner(userId) || isAdmin()) && isValidId(userId) && isValidId(assetId) && isValidAsset(incoming());
        allow delete: if (isOwner(userId) || isAdmin()) && isValidId(userId) && isValidId(assetId);
      }
      
      match /historyLogs/{historyId} {
        allow list, get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(historyId) && isValidHistoryLog(incoming());
        allow update: if isOwner(userId) && isValidId(userId) && isValidId(historyId) && (
          // Allow title update as long as it's within size limits
          incoming().diff(existing()).affectedKeys().hasOnly(['title']) &&
          incoming().title is string && incoming().title.size() <= 200
        );
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(historyId);
      }

      match /humanTouchRequests/{requestId} {
        allow list, get: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(requestId) && isValidHumanTouchRequest(incoming());
        allow update: if isOwner(userId) || isAdmin();
        allow delete: if isOwner(userId) || isAdmin();
      }
    }

    match /humanTouchRequests/{requestId} {
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow get: if isSignedIn() && isValidId(requestId) && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidId(requestId) && isValidGlobalHumanTouchRequest(incoming()) && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(requestId) && (
        isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'completedAssetUrl', 'completedComment', 'completedTimestamp'])
      );
      allow delete: if isSignedIn() && isValidId(requestId) && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /adminSettings/{docId} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(docId) && isValidAdminSettings(incoming());
      allow delete: if isAdmin();
    }

    match /salesSubmissions/{submissionId} {
      allow list: if isAdmin();
      allow get: if isSignedIn() && isValidId(submissionId) && (resource.data.email == request.auth.token.email || isAdmin());
      allow create: if isValidId(submissionId) && isValidSalesSubmission(incoming());
      allow update: if isSignedIn() && isValidId(submissionId) && isAdmin() && (
        incoming().diff(existing()).affectedKeys().hasOnly(['status'])
      );
      allow delete: if isSignedIn() && isValidId(submissionId) && isAdmin();
    }
  }
}
